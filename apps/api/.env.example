@@ -6,3 +6,18 @@ REFRESH_TOKEN_SECRET=your-refresh-secret

AI_SERVER_BASE_URL=http://127.0.0.1:8000/api/v3
AI_SERVER_TIMEOUT_MS=60000

# ── Phone Verification ──────────────────────────────────────────────────────
PHONE_VERIFICATION_TOKEN_SECRET=your-phone-verify-secret

# ── Social Login ─────────────────────────────────────────────────────────────
# 마스터 스위치: true 이면 모든 provider 실제 검증 활성화
SOCIAL_LOGIN_REAL_VERIFY_ENABLED=false

# Provider 개별 스위치 (마스터보다 우선)
GOOGLE_REAL_VERIFY_ENABLED=false or true
KAKAO_REAL_VERIFY_ENABLED=false or true
NAVER_REAL_VERIFY_ENABLED=false or true 

# Google: ID token 검증용 Client ID (GOOGLE_REAL_VERIFY_ENABLED=true 시 필수)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Kakao: 인가코드 교환용 (KAKAO_REAL_VERIFY_ENABLED=true 시 필수) // SocialCodeExchange
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret  # 선택 (Kakao 앱 보안 설정 활성화 시 필수)

# Naver: 인가코드 교환용 (NAVER_REAL_VERIFY_ENABLED=true 시 필수) // SocialCodeExchange
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret