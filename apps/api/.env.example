PORT=3000
DATABASE_URL="postgresql://codinator:codinator_pw@localhost:5432/codinator_db?schema=public"

ACCESS_TOKEN_SECRET=your-access-secret
REFRESH_TOKEN_SECRET=your-refresh-secret

AI_SERVER_BASE_URL=http://127.0.0.1:8000/api/v3
AI_SERVER_TIMEOUT_MS=60000

# ── Phone Verification ──────────────────────────────────────────────────────
PHONE_VERIFICATION_TOKEN_SECRET=your-phone-verify-secret

# ── Social Login ─────────────────────────────────────────────────────────────
# 모든 소셜 로그인은 실제 Provider API 를 직접 호출하여 검증합니다.
# mock/stub 전략은 완전 폐기되었으며, 실패 시 그대로 오류를 반환합니다.

# Google: ID token 검증용 Client ID (GOOGLE_CLIENT_ID 미설정 시 aud 검증 생략)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Kakao: 인가코드 교환용 (POST /auth/social/kakao/exchange-code 사용 시 필수) // SocialCodeExchange
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret  # 선택 (Kakao 앱 보안 설정 활성화 시 필수)

# Naver: 인가코드 교환용 (POST /auth/social/naver/exchange-code 사용 시 필수) // SocialCodeExchange
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
