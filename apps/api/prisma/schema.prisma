generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  MALE
  FEMALE
}

enum PostStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum EvaluationStatus {
  OPEN
  CLOSED
  ENDED
}

enum VoteChoice {
  LIKE
  DISLIKE
}

enum RankingPeriod {
  WEEKLY
  MONTHLY
}

enum RankingStatus {
  PENDING
  READY
  FAILED
}

enum GarmentCategory {
  TOP
  BOTTOM
  OUTER
  SHOES
  BAG
  ACCESSORY
  ETC
}

enum ReportReason {
  SPAM
  ABUSE
  INAPPROPRIATE
  ETC
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum BlurMethod {
  NONE
  AUTO
  MANUAL
}

enum AiBlurStatus {
  NONE
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(100)
  nickname     String     @unique @db.VarChar(30)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  gender       Gender
  birthDate    DateTime   @map("birth_date") @db.Date
  phoneNumber  String     @unique @map("phone_number") @db.VarChar(20)
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  posts               Post[]       @relation("PostAuthor")
  hiddenPosts         Post[]       @relation("PostHiddenBy")
  votes               Vote[]
  sessions            UserSession[]
  closedEvaluations   Evaluation[] @relation("EvaluationClosedBy")
  bookmarks           Bookmark[]
  reports             Report[]     @relation("ReportReporter")
  reviewedReports     Report[]     @relation("ReportReviewedBy")
  userReports         UserReport[] @relation("UserReportReporter")
  receivedUserReports UserReport[] @relation("UserReportTarget")
  reviewedUserReports UserReport[] @relation("UserReportReviewedBy")

  @@index([status])
  @@map("users")
}

model UserSession {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  deviceName       String?   @map("device_name") @db.VarChar(100)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Post {
  id           Int        @id @default(autoincrement())
  authorId     Int        @map("author_id")
  content      String    @db.VarChar(500)
  status       PostStatus @default(ACTIVE)
  publishedAt  DateTime?  @map("published_at")
  hiddenAt     DateTime?  @map("hidden_at")
  hiddenReason String?    @map("hidden_reason") @db.VarChar(255)
  hiddenById   Int?       @map("hidden_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  author         User            @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  hiddenBy       User?           @relation("PostHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  images         PostImage[]
  outfitItems    PostOutfit[]
  postKeywords   PostKeyword[]
  bookmarks      Bookmark[]
  reports        Report[]
  evaluation     Evaluation?
  rankingDetails RankingDetail[]

  @@index([authorId, status, createdAt])
  @@index([status, createdAt])
  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
  @@map("posts")
}

model PostImage {
  id                Int          @id @default(autoincrement())
  postId            Int          @map("post_id")
  storageKey        String?      @map("storage_key") @db.VarChar(255)
  originalImageUrl  String       @map("original_image_url") @db.VarChar(500)
  thumbnailUrl      String?      @map("thumbnail_url") @db.VarChar(500)
  sortOrder         Int          @default(0) @map("sort_order")
  isPrimary         Boolean      @default(false) @map("is_primary")
  processedImageUrl String?      @map("processed_image_url") @db.VarChar(500)
  blurMethod        BlurMethod   @default(NONE) @map("blur_method")
  aiBlurStatus      AiBlurStatus @default(NONE) @map("ai_blur_status")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, sortOrder])
  @@index([postId, isPrimary])
  @@map("post_images")
}

model PostOutfit {
  id        Int             @id @default(autoincrement())
  postId    Int             @map("post_id")
  category  GarmentCategory
  itemName  String?         @map("item_name") @db.VarChar(100)
  brand     String?         @db.VarChar(100)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, sortOrder])
  @@index([postId])
  @@map("post_outfits")
}

model Keyword {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(50)
  label        String        @db.VarChar(50)
  isActive     Boolean       @default(true) @map("is_active")
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  postKeywords PostKeyword[]

  @@index([isActive, sortOrder])
  @@index([label])
  @@map("keywords")
}

model PostKeyword {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  keywordId Int      @map("keyword_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Restrict)

  @@unique([postId, keywordId])
  @@index([keywordId, postId])
  @@index([postId])
  @@index([keywordId])
  @@map("post_keywords")
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([userId])
  @@index([postId])
  @@map("bookmarks")
}

model Report {
  id           Int          @id @default(autoincrement())
  reporterId   Int          @map("reporter_id")
  postId       Int          @map("post_id")
  title        String       @db.VarChar(100)
  reason       ReportReason
  description  String?      @db.VarChar(500)
  status       ReportStatus @default(PENDING)
  reviewedAt   DateTime?    @map("reviewed_at")
  reviewedById Int?         @map("reviewed_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  post       Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, postId])
  @@index([status, createdAt])
  @@index([postId, createdAt])
  @@index([postId])
  @@index([status])
  @@index([reviewedById])
  @@map("reports")
}

model UserReport {
  id             Int          @id @default(autoincrement())
  reporterId     Int          @map("reporter_id")
  reportedUserId Int          @map("reported_user_id")
  title          String       @db.VarChar(100)
  reason         ReportReason
  description    String?      @db.VarChar(500)
  status         ReportStatus @default(PENDING)
  reviewedAt     DateTime?    @map("reviewed_at")
  reviewedById   Int?         @map("reviewed_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  reporter     User  @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedUser User  @relation("UserReportTarget", fields: [reportedUserId], references: [id], onDelete: Restrict)
  reviewedBy   User? @relation("UserReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reportedUserId, createdAt])
  @@index([status, createdAt])
  @@index([reviewedById])
  @@index([reporterId, reportedUserId, status])
  @@map("user_reports")
}

model Evaluation {
  id          Int              @id @default(autoincrement())
  postId      Int              @unique @map("post_id")
  startsAt    DateTime         @map("starts_at")
  endsAt      DateTime         @map("ends_at")
  status      EvaluationStatus @default(OPEN)
  closedAt    DateTime?        @map("closed_at")
  closeReason String?          @map("close_reason") @db.VarChar(255)
  closedById  Int?             @map("closed_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes    Vote[]
  closedBy User? @relation("EvaluationClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([status, endsAt])
  @@index([closedById])
  @@map("evaluations")
}

model Vote {
  id                  Int        @id @default(autoincrement())
  evaluationId        Int        @map("evaluation_id")
  voterId             Int        @map("voter_id")
  choice              VoteChoice
  feedbackSubmittedAt DateTime?  @map("feedback_submitted_at")
  createdAt           DateTime   @default(now()) @map("created_at")

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  voter      User       @relation(fields: [voterId], references: [id], onDelete: Restrict)
  feedbacks  Feedback[]

  @@unique([evaluationId, voterId])
  @@index([voterId])
  @@index([evaluationId, choice])
  @@map("votes")
}

model FeedbackTag {
  id         Int        @id @default(autoincrement())
  code       String     @unique @db.VarChar(50)
  label      String     @db.VarChar(100)
  groupCode  String?    @map("group_code") @db.VarChar(50)
  voteChoice VoteChoice @map("vote_choice")
  isActive   Boolean    @default(true) @map("is_active")
  sortOrder  Int        @default(0) @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  feedbacks Feedback[]

  @@index([voteChoice, isActive, sortOrder])
  @@index([groupCode])
  @@map("feedback_tags")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  voteId    Int      @map("vote_id")
  tagId     Int      @map("tag_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vote Vote        @relation(fields: [voteId], references: [id], onDelete: Cascade)
  tag  FeedbackTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([voteId, tagId])
  @@unique([voteId, sortOrder])
  @@index([voteId])
  @@index([tagId])
  @@map("feedbacks")
}

model Ranking {
  id               Int           @id @default(autoincrement())
  period           RankingPeriod
  startDate        DateTime      @map("start_date") @db.Date
  endDate          DateTime      @map("end_date") @db.Date
  timezone         String        @default("Asia/Seoul") @db.VarChar(50)
  algorithmVersion Int           @default(1) @map("algorithm_version")
  status           RankingStatus @default(PENDING)
  generatedAt      DateTime?     @map("generated_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  details RankingDetail[]

  @@unique([period, startDate, endDate, timezone, algorithmVersion])
  @@index([period, startDate, endDate])
  @@index([status])
  @@map("rankings")
}

model RankingDetail {
  id           Int      @id @default(autoincrement())
  rankingId    Int      @map("ranking_id")
  postId       Int      @map("post_id")
  rank         Int
  score        Decimal  @default(0) @db.Decimal(10, 4)
  likeCount    Int      @default(0) @map("like_count")
  dislikeCount Int      @default(0) @map("dislike_count")
  totalCount   Int      @default(0) @map("total_count")
  likeRate     Decimal  @default(0) @map("like_rate") @db.Decimal(5, 4)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ranking Ranking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([rankingId, postId])
  @@unique([rankingId, rank])
  @@index([postId])
  @@map("ranking_details")
}
