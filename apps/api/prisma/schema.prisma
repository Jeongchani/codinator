generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  ACTIVE
  DELETED
}

enum EvaluationStatus {
  OPEN
  CLOSED
  ENDED
}

enum VoteChoice {
  LIKE
  DISLIKE
}

enum RankingPeriod {
  WEEKLY
  MONTHLY
}

enum FeedbackTagPolarity {
  POSITIVE
  NEGATIVE
}

enum GarmentCategory {
  TOP
  BOTTOM
  OUTER
  SHOES
  BAG
  ACCESSORY
  ETC
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

   refreshTokenHash  String?
   
  posts Post[]
  votes Vote[]

  @@map("users")
}

model Post {
  id        Int        @id @default(autoincrement())
  authorId  Int        @map("author_id")
  content   String?    @db.Text
  status    PostStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  deletedAt DateTime?  @map("deleted_at")

  author         User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  images         PostImage[]
  outfitItems    PostOutfitItem[]
  evaluation     Evaluation?
  rankingEntries RankingEntry[]

  @@index([authorId])
  @@index([status])
  @@map("posts")
}

model PostImage {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_images")
}

model PostOutfitItem {
  id        Int             @id @default(autoincrement())
  postId    Int             @map("post_id")
  category  GarmentCategory
  itemName  String?         @map("item_name") @db.VarChar(100)
  brand     String?         @db.VarChar(100)
  createdAt DateTime        @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_outfit_items")
}

model Evaluation {
  id        Int              @id @default(autoincrement())
  postId    Int              @unique @map("post_id")
  startsAt  DateTime         @map("starts_at")
  endsAt    DateTime         @map("ends_at")
  status    EvaluationStatus @default(OPEN)
  createdAt DateTime         @default(now()) @map("created_at")

  post  Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([status, endsAt])
  @@map("evaluations")
}

model Vote {
  id           Int        @id @default(autoincrement())
  evaluationId Int        @map("evaluation_id")
  voterId      Int        @map("voter_id")
  choice       VoteChoice
  createdAt    DateTime   @default(now()) @map("created_at")

  evaluation   Evaluation        @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  voter        User              @relation(fields: [voterId], references: [id], onDelete: Restrict)
  feedbackTags VoteFeedbackTag[]

  @@unique([evaluationId, voterId])
  @@index([voterId])
  @@index([evaluationId, choice])
  @@map("votes")
}

model FeedbackTag {
  id         Int                 @id @default(autoincrement())
  code       String              @unique @db.VarChar(50)
  label      String              @db.VarChar(100)
  polarity   FeedbackTagPolarity
  voteChoice VoteChoice          @map("vote_choice")
  isActive   Boolean             @default(true) @map("is_active")
  sortOrder  Int                 @default(0) @map("sort_order")

  voteFeedbackTags VoteFeedbackTag[]

  @@index([voteChoice, isActive, sortOrder])
  @@map("feedback_tags")
}

model VoteFeedbackTag {
  id        Int      @id @default(autoincrement())
  voteId    Int      @map("vote_id")
  tagId     Int      @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  vote Vote        @relation(fields: [voteId], references: [id], onDelete: Cascade)
  tag  FeedbackTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([voteId, tagId])
  @@index([tagId])
  @@map("vote_feedback_tags")
}

model RankingSnapshot {
  id        Int           @id @default(autoincrement())
  period    RankingPeriod
  startDate DateTime      @map("start_date") @db.Date
  endDate   DateTime      @map("end_date") @db.Date
  createdAt DateTime      @default(now()) @map("created_at")

  entries RankingEntry[]

  @@unique([period, startDate, endDate])
  @@index([period])
  @@map("ranking_snapshots")
}

model RankingEntry {
  id           Int      @id @default(autoincrement())
  snapshotId   Int      @map("snapshot_id")
  postId       Int      @map("post_id")
  rank         Int
  likeCount    Int      @default(0) @map("like_count")
  dislikeCount Int      @default(0) @map("dislike_count")
  totalCount   Int      @default(0) @map("total_count")
  likeRate     Decimal  @map("like_rate") @db.Decimal(5, 4)

  snapshot RankingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  post     Post            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, postId])
  @@unique([snapshotId, rank])
  @@index([postId])
  @@map("ranking_entries")
}