AI_ENV=development
AI_PORT=8000
AI_MAX_UPLOAD_SIZE_MB=10
AI_PROCESS_TIMEOUT_SECONDS=60
AI_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
AI_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
AI_BLUR_SIGMA=25
AI_FACE_MARGIN_RATIO=0.25

AI_MODEL_DEVICE=auto
AI_HF_HOME=
AI_HF_TOKEN=
AI_ENABLE_PARSER=true
AI_ENABLE_EMBEDDING=true
AI_ENABLE_CAPTION=true

AI_PARSER_MODEL_ID=fashn-ai/fashn-human-parser
AI_FASHION_CLIP_MODEL_ID=patrickjohncyh/fashion-clip
AI_FLORENCE_MODEL_ID=microsoft/Florence-2-base

AI_PARSER_MIN_AREA_RATIO=0.005
AI_PARSER_MIN_BOX_SIDE_PX=24
AI_IMAGE_MAX_SIDE=1280
AI_FLORENCE_PROMPT=<DETAILED_CAPTION>
AI_FLORENCE_MAX_NEW_TOKENS=128
